# https://docs.npmjs.com/cli/v11/using-npm/developers#keeping-files-out-of-your-package

# Tests and coverage
tests/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/
.nyc_output/

# Build and editor config
tsconfig.json
tsconfig.*.json
eslint.config.*
.prettierrc*
.prettierignore
.editorconfig
.gitignore
.gitattributes

# Documentation (keep README)
*.md
!README.md

# Source (publish compiled output from dist/ when you add a build)
src/

# Dependencies and logs
node_modules/
.DS_Store
*.log
*.swp
*~
